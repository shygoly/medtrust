{
  "name": "@medtrust/domain-power",
  "version": "0.1.0",
  "description": "电力行业包：城市用电异常监测、新能源消纳预测、车网供需协同三个场景的声明与目录种子，以及 MDOP 标准场景（负荷预测 / 需求响应 / 窃电检测）的 SPI 挂载骨架。尚未接管主线算子（D-SPD-6）。",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@medtrust/mdop": "workspace:*",
    "@medtrust/space-kernel-spi": "workspace:*",
    "@nestjs/common": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "<rootDir>/../coverage"
  },
  "license": "LicenseRef-MedTrust-Research-1.0"
}
