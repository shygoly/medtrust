{
  "name": "@medtrust/domain-power",
  "version": "1.0.0",
  "description": "电力行业包：河南电力空间场景 + MDOP 标准场景（负荷预测 / 需求响应 / 窃电检测）算子、模板、沙箱、收集器与隐私闸。",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=perf",
    "test:perf": "jest --passWithNoTests --testPathPattern=perf.spec",
    "test:privacy": "jest --passWithNoTests --testPathPattern=privacy/|egress-gate",
    "test:coverage": "jest --passWithNoTests --coverage --testPathIgnorePatterns=perf"
  },
  "dependencies": {
    "@medtrust/mdop": "workspace:*",
    "@medtrust/space-kernel-spi": "workspace:*",
    "@medtrust/wasm-algorithms": "workspace:*",
    "@nestjs/common": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!scenarios.ts",
      "!exchange.ts",
      "!seams.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80
      }
    },
    "coverageDirectory": "<rootDir>/../coverage"
  },
  "license": "LicenseRef-MedTrust-Research-1.0"
}
