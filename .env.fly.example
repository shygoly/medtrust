# MedTrust Fly.io 部署环境变量配置
# 复制此文件为 .env.fly 并填写实际值

# ============================================
# 基础配置
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# 数据库 (SQLite)
# ============================================
DATABASE_PATH=/data/medtrust.db

# ============================================
# JWT 认证
# ============================================
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=7d

# ============================================
# FATE Flow 联邦学习服务
# ============================================
# Lite 版 (模拟)
FATE_FLOW_URL=https://medtrust-lite-fate.fly.dev

# Full 版 (真实)
# FATE_FLOW_URL=https://your-fate-flow-app.fly.dev

# ============================================
# FISCO BCOS 区块链
# ============================================
# Lite 版 (单节点)
FISCO_NODE_URL=http://medtrust-lite-fisco.fly.dev:8545
FISCO_CHAIN_ID=1
FISCO_GROUP_ID=1

# Full 版 (多节点)
# FISCO_NODE1_URL=http://your-fisco-node1.fly.dev:8545
# FISCO_NODE2_URL=http://your-fisco-node2.fly.dev:8545
# FISCO_NODE3_URL=http://your-fisco-node3.fly.dev:8545

# 合约地址 (部署后填入)
FISCO_ATTESTATION_CONTRACT=0x...

# ============================================
# MP-SPDZ 多方安全计算
# ============================================
# Lite 版 (模拟)
MPC_GATEWAY_URL=https://medtrust-lite-mpc.fly.dev

# Full 版 (真实)
# MPC_GATEWAY_URL=https://your-mpc-gateway.fly.dev

MPC_PROTOCOL=shamir
MPC_PARTIES=3

# ============================================
# TEE 可信执行环境 (阿里云)
# ============================================
# 如需使用真实TEE服务，配置阿里云账号
ALIYUN_ACCESS_KEY_ID=your-access-key
ALIYUN_ACCESS_KEY_SECRET=your-secret-key
ALIYUN_REGION=cn-hangzhou
TEE_IMAGE_ID=your-tee-image-id

# ============================================
# HashiCorp Vault (密钥管理)
# ============================================
VAULT_ADDR=https://your-vault-server.com
VAULT_TOKEN=your-vault-token

# ============================================
# 邮件服务 (可选)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# ============================================
# 日志级别
# ============================================
LOG_LEVEL=info
