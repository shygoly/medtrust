{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e.spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@medtrust/database$": "<rootDir>/../../packages/database/src",
    "^@medtrust/database/(.*)$": "<rootDir>/../../packages/database/src/$1"
  }
}
