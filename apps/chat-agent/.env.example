# MedTrust Chat Agent（端口 5032；5020-5031 已分配完，见 DEPLOY.md §1）
PORT=5032
NODE_ENV=development

# 控制面 API（apps/api）
MEDTRUST_API_URL=http://localhost:5021
MEDTRUST_API_PREFIX=/api/v1

# LLM：留空则退化为确定性规则客户端（无需外部供应商即可跑通全流程）
# LLM 供应商：deepseek（当前部署）/ anthropic / rule-based（确定性回退，不出域）
# 留空则按"哪个 key 在"推断；显式指定却缺 key 会退回 rule-based（/health/ready 可查）
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Anthropic（可选，LLM_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096

# agent 自有凭证（AGENT.md R2）：仅用于目录等元数据读取，绝不复用调用者的 token。
# 留空则读公开目录端点 /public/catalog。
CHAT_AGENT_SERVICE_TOKEN=

# 会话
SESSION_TTL_HOURS=24
AGENT_CONTEXT_MAX_MESSAGES=20

# 提交作业时的治理默认值（卡片里不可见的假设，见 README）
DEFAULT_CONTRACTS=
DEFAULT_MIN_CELL=5
DEFAULT_WINDOW_DAYS=90

# 会话存储：memory（默认，dev/test 可移植）| sqlite（生产；需 Node 20 基线，better-sqlite3 原生模块）
CHAT_AGENT_DB=memory
CHAT_AGENT_DB_PATH=./data/chat-agent.db

# 生产加固（M4）
# 单条消息字符上限（超出 413）
CHAT_MAX_MESSAGE_CHARS=4000
# 限流：每用户 / 每 IP 每分钟请求数；0 = 关闭该维度（多实例下是每实例限流）
RATE_LIMIT_PER_USER_PER_MIN=30
RATE_LIMIT_PER_IP_PER_MIN=120
# /api/v1/metrics（Prometheus 文本格式）
METRICS_ENABLED=true
# /api/docs（OpenAPI/Swagger UI）与 /api/docs-json
SWAGGER_ENABLED=true

# Redis（可选）：目录缓存 + 跨实例共享限流。
# 留空 = 不启用（缓存关闭、限流退化为每实例）；配置了但连不上会拒绝启动（部署错误不静默降级）。
REDIS_URL=
CACHE_DIRECTORY_TTL_SECONDS=300
REDIS_KEY_PREFIX=medtrust:chat-agent

# OpenTelemetry 追踪（可选）。默认关闭时不加载 SDK；开启后需要可达的 collector。
# 本地想肉眼验证：OTEL_ENABLED=true OTEL_EXPORTER=console
OTEL_ENABLED=false
OTEL_SERVICE_NAME=medtrust-chat-agent
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# debug | info | warn | error
LOG_LEVEL=info
# json（生产）| pretty（本地）
LOG_FORMAT=json
