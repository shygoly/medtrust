{
  "name": "@medtrust/chat-agent",
  "version": "0.1.0",
  "private": true,
  "description": "MedTrust 可信空间对话式任务配置 Agent（Pi Agent 轻量架构：prompt + tools + cards）",
  "license": "LicenseRef-MedTrust-Research-1.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @medtrust/pi-agent build && pnpm --filter @medtrust/chat-cards build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@medtrust/chat-cards": "workspace:*",
    "@medtrust/mdop": "workspace:*",
    "@medtrust/pi-agent": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@nestjs/typeorm": "^10.0.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
