{
  "name": "@medtrust/connector",
  "version": "1.0.0",
  "description": "MedTrust data-space connector — deployed on each participant (hospital/pharma) local side. Raw data never leaves it.",
  "private": true,
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "demo": "ts-node src/demo/run-local-loop.ts",
    "demo:e2e": "ts-node src/demo/run-e2e.ts",
    "test": "jest",
    "demo:he": "ts-node src/demo/run-he.ts",
    "demo:cross": "ts-node src/demo/run-cross.ts",
    "demo:synthea-e2e": "npx tsx src/demo/run-synthea-e2e.ts",
    "demo:amr-q1": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-q1-e2e.ts",
    "demo:amr-q2": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-q2-e2e.ts",
    "demo:amr-q2-unlock": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-q2-unlock-e2e.ts",
    "demo:amr-exp-c": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-exp-c-e2e.ts",
    "demo:amr-q1-breakpoint-sens": "pnpm run demo:amr-exp-c",
    "demo:amr-q4": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-q4-e2e.ts",
    "demo:amr-q3": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-q3-e2e.ts",
    "demo:amr-q5": "TS_NODE_TRANSPILE_ONLY=1 ts-node --transpile-only src/demo/run-amr-q5-e2e.ts",
    "ingest-synthea": "ts-node ../../scripts/ingest-synthea.ts",
    "demo:analytics-ladder": "ts-node src/demo/run-analytics-ladder-e2e.ts",
    "testdata:generate": "ts-node src/testdata/generate.ts",
    "testdata:export-demo": "ts-node src/testdata/export-demo-slices.ts",
    "reproduce:l4": "ts-node src/repro/reproduce-l4.ts"
  },
  "dependencies": {
    "@medtrust/database": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "better-sqlite3": "^9.4.0",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "node-seal": "^5.1.4",
    "sm-crypto": "^0.3.14",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}