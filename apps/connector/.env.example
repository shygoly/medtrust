# Connector outbound pull loop (RWS)
CONNECTOR_PORT=5022
CONNECTOR_PARTICIPANT_ID=p-ruijin
CONNECTOR_PULL_TOKEN=dev-connector-token
# P1-4 cert auth (optional; register a connector to get these values)
# CONNECTOR_CERT_FINGERPRINT=SM2:...
# CONNECTOR_SM2_PRIVATE_KEY=
# P1-9 heartbeat version
# CONNECTOR_VERSION=1.0.0
CONTROL_PLANE_URL=http://localhost:5021/api/v1
CONNECTOR_POLL_INTERVAL_MS=5000

# Optional: override monorepo data root
# CONNECTOR_DATA_ROOT=C:/Chada/MedTrust/medtrust

# L3 causal: local apps/agent gRPC (required to run causal-survival / causal-psm)
AGENT_GRPC_URL=127.0.0.1:5024
