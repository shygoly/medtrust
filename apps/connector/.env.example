# Connector outbound pull loop (RWS)
CONNECTOR_PORT=5022
CONNECTOR_PARTICIPANT_ID=p-demohospb
# 缺省强制证书认证:本地开发若要走令牌降级,须置 true 且显式配置令牌值
CONNECTOR_TOKEN_AUTH_ALLOWED=true
CONNECTOR_PULL_TOKEN=dev-connector-token
# P1-4 cert auth(生产必填:注册连接器后由平台 CA 签发)
# CONNECTOR_CERT_FINGERPRINT=SM2:...
# CONNECTOR_SM2_PRIVATE_KEY=
# 或改用本地私钥文件(0600,推荐;与上一行二选一)
# CONNECTOR_SM2_PRIVATE_KEY_FILE=data/connector-sm2.key
# CA 根钥:只验连接器证书链(D-MDOP-3 三钥分离后不再签任务/模块)
# CONNECTOR_PLATFORM_CA_PUBKEY=
# 平台节点公钥:验下发任务签名、执行凭证、吊销名单、合约副署
# CONNECTOR_PLATFORM_NODE_PUBKEY=
# 注册中心公钥:验算子清单与算法模块签名(P-CTL-6 专用算法签名密钥)
# CONNECTOR_REGISTRY_PUBKEY=
# 本地管理令牌(mdop-kernel:合约确认/拒绝/撤销;不配则本地管理接口一律 401)
# CONNECTOR_LOCAL_ADMIN_TOKEN=
# 本地合约确认策略(缺省人工确认;自动确认只认策略文件里点名的合约)
# CONNECTOR_MDOP_CONTRACT_POLICY_FILE=
# MDOP 内核总开关(缺省 false;开启后才处理合约要约/片段复核/执行/销毁链路)
# MDOP_ENABLED=false
# 会话见证核验用的 KMS 公钥(缺省空＝见证一律记拒绝;MUST 来自部署配置)
CONNECTOR_MDOP_KMS_PUBKEY=
# C2 信封的水印前缀(实际写入值会附当天日期,用于事后追溯密文出自哪个站点/哪一天)
CONNECTOR_MDOP_WATERMARK=wm:connector
# 数据密钥保管方标识(写进信封 wrapped_key.kms);留空＝未接入 KMS,seal 一律 fail-closed
CONNECTOR_MDOP_KMS_REF=
# 本地合约确认策略文件(JSON);review=auto 且合约在点名列表里才自动确认;文件不存在＝人工确认
CONNECTOR_MDOP_CONTRACT_POLICY_FILE=
# ---- 可信空间节点组件（独立进程；缺省不启动）----
# 节点参与方 id（独立于本院连接器的参与方）
TEE_NODE_PARTICIPANT_ID=
# 节点自持私钥文件（权限必须 0600）
TEE_NODE_KEY_FILE=data/tee-node-sm2.key
# 证明提供者：software（开发替身）| hardware（真实证明代理）
TEE_NODE_ATTESTATION_PROVIDER=software
# KMS 客户端模式：local-dev（演练）| remote（持有方自建/共管）
TEE_NODE_KMS_MODE=local-dev
TEE_NODE_KMS_REF=kms://local-dev
# 核对 KMS 释放凭据用的公钥（MUST 来自部署配置）
TEE_NODE_KMS_PUBKEY=
# 显式允许开发替身（生产环境即便设为 true 也会被拒）
TEE_NODE_ALLOW_DEV_PROVIDERS=false
# 平台 CA 签发的节点证书指纹（长轮询出站认证用）
TEE_NODE_CERT_FINGERPRINT=
# 平台节点公钥（验证平台下发的信封；MUST 来自部署配置）
TEE_NODE_PLATFORM_PUBKEY=
# 注册中心公钥（核验随长轮询下发的算子清单；MUST 来自部署配置）
TEE_NODE_REGISTRY_PUBKEY=
# 参与方登记公钥表（JSON 文件：{ "<URN>": "<公钥hex>" }；验合约副本与信封的持有方签名）
TEE_NODE_PARTICIPANT_KEYS_FILE=
# 本地模块库目录（模块按 <sm3hex>.wasm 命名；执行只从本地取字节）
TEE_NODE_MODULE_DIR=
# 允许运行的执行环境度量（逗号分隔；留空 = 不接受任何 C2 要约）
TEE_NODE_MEASUREMENTS=
# 校验方的证明服务地址（探针用；留空 = 不跑探针）
TEE_NODE_VERIFIER_URL=
# 节点本地状态目录（回执链/制品/去重表；目录 0700、文件 0600；须挂持久卷）
TEE_NODE_DATA_DIR=data/tee-node
# 院内计算后端共享凭证(连接器 ↔ agent,≥32 字节)
# AGENT_SHARED_TOKEN=
# P1-9 heartbeat version
# CONNECTOR_VERSION=1.0.0
CONTROL_PLANE_URL=http://localhost:5021/api/v1
# 长轮询等待上限(服务端硬上限 25s)
CONNECTOR_LONG_POLL_WAIT_MS=25000
# 执行队列并发上限
CONNECTOR_TASK_CONCURRENCY=4

# Optional: override monorepo data root
# CONNECTOR_DATA_ROOT=C:/Chada/MedTrust/medtrust

# 院内计算后端 gRPC(本院网络内,只受本院连接器调用)
AGENT_GRPC_URL=127.0.0.1:5024
