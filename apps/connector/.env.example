# 连接器进程配置。平台配置在 apps/api/.env。
# CONNECTOR_DB_URL / DB_SYNCHRONIZE 由 src/load-env.ts 在连库前装入。
# 复制为本目录 .env 后按本院填写；不要提交真实口令。

CONNECTOR_PORT=5022
# 示范乙。示范甲用 p-demohospa / cn-demohospa。
CONNECTOR_PARTICIPANT_ID=p-demohospb
CONNECTOR_ID=cn-demohospb
# 每个连接器必须使用自己的 PostgreSQL 数据库和凭据。
CONNECTOR_DB_URL=postgres://connector:password@localhost:5432/medtrust_connector
DB_SYNCHRONIZE=false

# 令牌通道。平台 apps/api/.env 里的 CONNECTOR_PULL_TOKEN 必须是同一个值，
# 且平台还需 CONNECTOR_TOKEN_AUTH_ALLOWED=true 才会接受令牌。
# 入网批准并写入证书指纹后，出站改走证书头，不必再依赖令牌。
CONNECTOR_TOKEN_AUTH_ALLOWED=true
CONNECTOR_PULL_TOKEN=dev-connector-token
CONTROL_PLANE_URL=http://localhost:5021/api/v1

# 不开启则进程只轮询，不处理合约要约。
MDOP_ENABLED=true
CONNECTOR_LONG_POLL_WAIT_MS=25000
CONNECTOR_TASK_CONCURRENCY=4

# 院内页面 http://localhost:5022/local 使用这个口令。不要发给平台。
CONNECTOR_LOCAL_ADMIN_TOKEN=dev-local-admin

# ---- 只读目录服务（NDI-TR-2025-05 §7.2；缺省关闭）----
# 开启后在 5022 上暴露 GET /connector/catalog/products[/:id]，只回元数据。
# **部署边界**：5022 只在院内网可达，MUST NOT 发布到院内网之外（见 docs/医院连接器独立部署准备.md §2.3）。
# CONNECTOR_CATALOG_PEERS 为对端 participantId 白名单（逗号分隔）；留空表示不按对端过滤。
# CONNECTOR_CATALOG_SERVICE=off
# CONNECTOR_CATALOG_PEERS=

# 本机私钥文件（0600；Windows 下权限检查会跳过）。
# 也可内联 CONNECTOR_SM2_PRIVATE_KEY=（与文件二选一，内联优先）。
# 证书指纹 CONNECTOR_CERT_FINGERPRINT、三把平台公钥
# CONNECTOR_PLATFORM_CA_PUBKEY / CONNECTOR_PLATFORM_NODE_PUBKEY / CONNECTOR_REGISTRY_PUBKEY
# 由院内「申请入网」+ 运营方批准后写入 data/connector-enrollment.json，勿手填进本文件。
CONNECTOR_SM2_PRIVATE_KEY_FILE=data/connector-sm2.key

# ---- 可选：本地合约自动确认（缺省人工确认，留空即可）----
# CONNECTOR_MDOP_CONTRACT_POLICY_FILE=data/mdop-contract-policy.json

# ---- 可选：MDOP 信封 / KMS（未接 KMS 时 seal 会 fail-closed）----
# CONNECTOR_MDOP_KMS_PUBKEY=
# CONNECTOR_MDOP_WATERMARK=wm:connector
# CONNECTOR_MDOP_KMS_REF=

# ---- 可选：院内计算后端（连接器 ↔ agent）----
# AGENT_GRPC_URL=127.0.0.1:5024
# AGENT_SHARED_TOKEN=

# ---- 可选：覆盖 monorepo 数据根 / 心跳版本 ----
# CONNECTOR_DATA_ROOT=
# CONNECTOR_VERSION=1.0.0

# ---- 可信空间节点组件（独立进程；缺省不启动）----
# TEE_NODE_PARTICIPANT_ID=
# TEE_NODE_KEY_FILE=data/tee-node-sm2.key
# TEE_NODE_ATTESTATION_PROVIDER=software
# TEE_NODE_KMS_MODE=local-dev
# TEE_NODE_KMS_REF=kms://local-dev
# TEE_NODE_KMS_PUBKEY=
# TEE_NODE_DEV_KMS_KEY_FILE=
# TEE_NODE_DEV_KMS_KEYS_FILE=
# TEE_NODE_ALLOW_DEV_PROVIDERS=false
# TEE_NODE_CERT_FINGERPRINT=
# TEE_NODE_PLATFORM_PUBKEY=
# TEE_NODE_REGISTRY_PUBKEY=
# TEE_NODE_PARTICIPANT_KEYS_FILE=
# TEE_NODE_MODULE_DIR=
# TEE_NODE_MEASUREMENTS=
# TEE_NODE_VERIFIER_URL=
# TEE_NODE_DATA_DIR=data/tee-node
