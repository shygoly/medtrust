{
  "name": "medtrust",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "governance": "node vendor/ai-factory/factory/verifiers/run-all.mjs ./governance.adapter.mjs",
    "governance:negative": "node scripts/governance/negative-verify.mjs",
    "test": "node scripts/check-meta-docs.mjs && node scripts/check-c2-traceability.mjs && node scripts/check-protocol-error-codes.mjs && node scripts/check-tee-claims.mjs && node scripts/check-crypto-imports.mjs && node scripts/check-software-sealed-compute-prod.mjs && node --test scripts/check-c2-traceability.test.mjs scripts/check-protocol-error-codes.test.mjs scripts/check-tee-claims.test.mjs scripts/check-crypto-imports.test.mjs scripts/check-software-sealed-compute-prod.test.mjs && pnpm governance && node scripts/governance/negative-verify.mjs && pnpm -r test",
    "check:meta": "node scripts/check-meta-docs.mjs",
    "check:trace": "node scripts/check-c2-traceability.mjs",
    "check:errors": "node scripts/check-protocol-error-codes.mjs",
    "check:tee": "node scripts/check-tee-claims.mjs",
    "check:crypto": "node scripts/check-crypto-imports.mjs",
    "check:software-sealed-compute": "node scripts/check-software-sealed-compute-prod.mjs",
    "test:trace": "node --test scripts/check-c2-traceability.test.mjs scripts/check-protocol-error-codes.test.mjs",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter database migrate",
    "db:seed": "pnpm --filter database seed",
    "split-synthea": "npx tsx scripts/split-synthea-hospitals.ts",
    "build-synthea-connectors": "npx tsx scripts/build-synthea-connectors.ts",
    "ingest-synthea": "npx tsx scripts/ingest-synthea.ts",
    "demo:synthea-e2e": "pnpm --filter @medtrust/connector demo:synthea-e2e",
    "verify:lora": "pnpm --filter @medtrust/api verify:lora",
    "reproduce:l4": "pnpm --filter @medtrust/connector reproduce:l4",
    "prepare": "husky"
  },
  "devDependencies": {
    "@medtrust/mdop": "workspace:*",
    "@types/node": "^20.0.0",
    "husky": "^9.0.0",
    "sm-crypto": "^0.3.14",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
