{
  "name": "medtrust",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "governance": "node vendor/ai-factory/factory/verifiers/run-all.mjs ./governance.adapter.mjs",
    "governance:negative": "node scripts/governance/negative-verify.mjs",
    "test": "node scripts/check-meta-docs.mjs && pnpm -r test",
    "check:meta": "node scripts/check-meta-docs.mjs",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter database migrate",
    "db:seed": "pnpm --filter database seed",
    "split-synthea": "npx tsx scripts/split-synthea-hospitals.ts",
    "build-synthea-connectors": "npx tsx scripts/build-synthea-connectors.ts",
    "ingest-synthea": "npx tsx scripts/ingest-synthea.ts",
    "demo:synthea-e2e": "pnpm --filter @medtrust/connector demo:synthea-e2e",
    "verify:lora": "pnpm --filter @medtrust/api verify:lora",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "husky": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
