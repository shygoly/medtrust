// ============ 业务 API（需要认证）============

// 机构管理
app.get('/api/tenants', authenticateToken, requirePermissions('tenant:read'), (req, res) => {
  res.json({ data: tenants });
});

app.get('/api/tenants/:id', authenticateToken, requirePermissions('tenant:read'), (req, res) => {
  const tenant = tenants.find(t => t.id === parseInt(req.params.id));
  res.json({ data: tenant });
});

app.post('/api/tenants', authenticateToken, requirePermissions('tenant:create'), (req, res) => {
  const newTenant = {
    id: tenants.length + 1,
    ...req.body,
    status: 'pending',
    joinedAt: new Date().toISOString().split('T')[0]
  };
  tenants.push(newTenant);
  res.json({ data: newTenant });
});

// 数据资产管理
app.get('/api/assets', authenticateToken, requirePermissions('asset:read'), (req, res) => {
  // 根据用户数据范围过滤
  const user = req.user;
  let filteredAssets = assets;

  // 获取用户完整信息以获取 dataScope
  const userInfo = getUserWithPermissions(user.id);

  if (!userInfo) {
    return res.status(404).json({ error: '用户不存在' });
  }

  // 根据 dataScope 过滤
  if (userInfo.permissions.includes('*') || userInfo.dataScope === 'all') {
    // 管理员或 dataScope=all 的用户看所有
    filteredAssets = assets;
  } else if (userInfo.dataScope === 'tenant' && userInfo.tenantId) {
    // tenant 级别只看自己机构的
    filteredAssets = assets.filter(a => a.tenantId.toString() === userInfo.tenantId);
  } else if (userInfo.dataScope === 'department' && userInfo.departmentId) {
    // department 级别只看自己科室的（暂时按 tenant 过滤）
    filteredAssets = assets.filter(a => a.tenantId.toString() === userInfo.tenantId);
  } else if (userInfo.dataScope === 'self') {
    // self 级别只看自己创建的（暂时返回空）
    filteredAssets = [];
  }

  res.json({ data: filteredAssets });
});

app.get('/api/assets/:id', authenticateToken, requirePermissions('asset:read'), (req, res) => {
  const asset = assets.find(a => a.id === parseInt(req.params.id));
  res.json({ data: asset });
});

