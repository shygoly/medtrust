    ...req.body,
    status: 'pending',
    createdAt: new Date().toISOString().split('T')[0],
    approvals: []
  };
  accessRequests.push(newRequest);
  res.json({ data: newRequest });
});

app.put('/api/access-requests/:id/approve', authenticateToken, requirePermissions('access-request:approve'), (req, res) => {
  const request = accessRequests.find(r => r.id === req.params.id);
  if (request) {
    request.status = 'completed';
    request.approvals.push('approved');
  }
  res.json({ data: request });
});

