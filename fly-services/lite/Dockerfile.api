# MedTrust API + Web 合并服务
FROM node:20-alpine

WORKDIR /app

# 安装依赖
RUN npm init -y && npm install express cors @faker-js/faker better-sqlite3 jsonwebtoken bcryptjs uuid

# 创建 API 服务
COPY <<'EOF' /app/index.js
const express = require('express');
const cors = require('cors');
const { faker } = require('@faker-js/faker');
const path = require('path');
const fs = require('fs');
const Database = require('better-sqlite3');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');
const { v4: uuidv4 } = require('uuid');

const app = express();
app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || 'medtrust-demo-secret-key';
const JWT_EXPIRES_IN = '24h';

// 初始化数据库
const db = new Database('/data/medtrust.db');
db.pragma('journal_mode = WAL');

// 创建表结构
function initDatabase() {
  // 用户表
  db.exec(`
    CREATE TABLE IF NOT EXISTS users (
      id TEXT PRIMARY KEY,
      username TEXT UNIQUE NOT NULL,
      password_hash TEXT NOT NULL,
      email TEXT,
      real_name TEXT NOT NULL,
      tenant_id TEXT NOT NULL,
      department_id TEXT,
      data_scope TEXT DEFAULT 'self',
      status TEXT DEFAULT 'active',
      last_login_at TEXT,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
      is_deleted INTEGER DEFAULT 0
    )
  `);

  // 角色表
  db.exec(`
    CREATE TABLE IF NOT EXISTS roles (
      id TEXT PRIMARY KEY,
      code TEXT UNIQUE NOT NULL,
      name TEXT NOT NULL,
      description TEXT,
      tenant_id TEXT,
      data_scope TEXT DEFAULT 'self',
      is_system INTEGER DEFAULT 0,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `);

  // 权限表
  db.exec(`
    CREATE TABLE IF NOT EXISTS permissions (
      id TEXT PRIMARY KEY,
      code TEXT UNIQUE NOT NULL,
      name TEXT NOT NULL,
      resource TEXT NOT NULL,
      action TEXT NOT NULL,
      description TEXT,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `);

  // 角色权限关联表
  db.exec(`
    CREATE TABLE IF NOT EXISTS role_permissions (
      id TEXT PRIMARY KEY,
      role_id TEXT NOT NULL,
      permission_id TEXT NOT NULL,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (role_id) REFERENCES roles(id) ON DELETE CASCADE,
      FOREIGN KEY (permission_id) REFERENCES permissions(id) ON DELETE CASCADE,
      UNIQUE(role_id, permission_id)
    )
  `);

  // 用户角色关联表
  db.exec(`
    CREATE TABLE IF NOT EXISTS user_roles (
      id TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      role_id TEXT NOT NULL,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
      FOREIGN KEY (role_id) REFERENCES roles(id) ON DELETE CASCADE,
      UNIQUE(user_id, role_id)
    )
  `);

  console.log('✓ Database tables created');
}

// 初始化权限数据
function seedPermissions() {
  const permissions = [
    { code: 'tenant:read', name: '查看机构', resource: 'tenant', action: 'read' },
    { code: 'tenant:create', name: '创建机构', resource: 'tenant', action: 'create' },
    { code: 'tenant:update', name: '更新机构', resource: 'tenant', action: 'update' },
    { code: 'asset:read', name: '查看数据资产', resource: 'asset', action: 'read' },
    { code: 'asset:create', name: '创建数据资产', resource: 'asset', action: 'create' },
    { code: 'asset:update', name: '更新数据资产', resource: 'asset', action: 'update' },
    { code: 'access-request:read', name: '查看申请', resource: 'access-request', action: 'read' },
    { code: 'access-request:create', name: '创建申请', resource: 'access-request', action: 'create' },
    { code: 'access-request:approve', name: '审批申请', resource: 'access-request', action: 'approve' },
    { code: 'blockchain:read', name: '查看区块链', resource: 'blockchain', action: 'read' },
    { code: 'blockchain:verify', name: '验证存证', resource: 'blockchain', action: 'verify' },
    { code: 'user:read', name: '查看用户', resource: 'user', action: 'read' },
    { code: 'user:create', name: '创建用户', resource: 'user', action: 'create' },
    { code: 'user:update', name: '更新用户', resource: 'user', action: 'update' },
  ];

  const insertPermission = db.prepare(`
    INSERT OR IGNORE INTO permissions (id, code, name, resource, action)
    VALUES (?, ?, ?, ?, ?)
  `);

  for (const perm of permissions) {
    insertPermission.run(uuidv4(), perm.code, perm.name, perm.resource, perm.action);
  }

  console.log('✓ Permissions seeded');
}

// 初始化角色数据
function seedRoles() {
  const roles = [
    { code: 'admin', name: '系统管理员', dataScope: 'all', isSystem: 1, permissions: ['*'] },
    { code: 'provider-admin', name: '数据提供方管理员', dataScope: 'tenant', isSystem: 1, permissions: [
      'asset:read', 'asset:create', 'asset:update',
      'access-request:read', 'access-request:approve',
      'blockchain:read', 'blockchain:verify',
      'user:read', 'user:create'
    ]},
    { code: 'consumer', name: '数据消费方', dataScope: 'tenant', isSystem: 1, permissions: [
      'asset:read',
      'access-request:read', 'access-request:create'
    ]},
    { code: 'regulator', name: '监管方', dataScope: 'all', isSystem: 1, permissions: [
      'tenant:read',
      'asset:read',
      'access-request:read', 'access-request:approve',
      'blockchain:read', 'blockchain:verify'
    ]},
  ];

  const insertRole = db.prepare(`
    INSERT OR IGNORE INTO roles (id, code, name, data_scope, is_system)
    VALUES (?, ?, ?, ?, ?)
  `);

  const getPermissionId = db.prepare('SELECT id FROM permissions WHERE code = ?');
  const insertRolePermission = db.prepare(`
    INSERT OR IGNORE INTO role_permissions (id, role_id, permission_id)
    VALUES (?, ?, ?)
  `);

  for (const role of roles) {
    const roleId = uuidv4();
    insertRole.run(roleId, role.code, role.name, role.dataScope, role.isSystem);

    // 分配权限
    if (role.permissions.includes('*')) {
      // 管理员拥有所有权限
      const allPermissions = db.prepare('SELECT id FROM permissions').all();
      for (const perm of allPermissions) {
        insertRolePermission.run(uuidv4(), roleId, perm.id);
      }
    } else {
      for (const permCode of role.permissions) {
        const perm = getPermissionId.get(permCode);
        if (perm) {
          insertRolePermission.run(uuidv4(), roleId, perm.id);
        }
      }
    }
  }

  console.log('✓ Roles seeded');
}

// 初始化测试用户
async function seedUsers() {
  const users = [
    // 前端快速登录使用的邮箱格式账号
    { username: 'admin@huashan-hospital.com', password: 'demo123456', realName: '华山医院管理员', tenantId: '1', role: 'provider-admin', dataScope: 'tenant' },
    { username: 'admin@rjh.com.cn', password: 'demo123456', realName: '瑞金医院管理员', tenantId: '2', role: 'provider-admin', dataScope: 'tenant' },
    { username: 'research@meddata-inst.edu.cn', password: 'demo123456', realName: '医科大数据研究院研究员', tenantId: '3', role: 'consumer', dataScope: 'tenant' },
    { username: 'contact@smartmed-ai.com', password: 'demo123456', realName: '智慧医疗AI科技', tenantId: '4', role: 'consumer', dataScope: 'tenant' },
    { username: 'data-governance@health.gov.cn', password: 'demo123456', realName: '区域卫健委监管员', tenantId: '5', role: 'regulator', dataScope: 'all' },
    // 保留原有的用户名格式账号（向后兼容）
    { username: 'admin', password: 'admin123', realName: '系统管理员', tenantId: '0', role: 'admin', dataScope: 'all' },
    { username: 'hospital1', password: 'hospital123', realName: '华山医院管理员', tenantId: '1', role: 'provider-admin', dataScope: 'tenant' },
    { username: 'hospital2', password: 'hospital123', realName: '瑞金医院管理员', tenantId: '2', role: 'provider-admin', dataScope: 'tenant' },
    { username: 'researcher1', password: 'researcher123', realName: '研究员', tenantId: '3', role: 'consumer', dataScope: 'tenant' },
    { username: 'regulator1', password: 'regulator123', realName: '监管员', tenantId: '5', role: 'regulator', dataScope: 'all' },
  ];

  const insertUser = db.prepare(`
    INSERT OR IGNORE INTO users (id, username, password_hash, real_name, tenant_id, data_scope)
    VALUES (?, ?, ?, ?, ?, ?)
  `);

  const getRole = db.prepare('SELECT id FROM roles WHERE code = ?');
  const insertUserRole = db.prepare(`
    INSERT OR IGNORE INTO user_roles (id, user_id, role_id)
    VALUES (?, ?, ?)
  `);

  for (const user of users) {
    const userId = uuidv4();
    const passwordHash = await bcrypt.hash(user.password, 10);

    insertUser.run(userId, user.username, passwordHash, user.realName, user.tenantId, user.dataScope);

    // 分配角色
    const role = getRole.get(user.role);
    if (role) {
      insertUserRole.run(uuidv4(), userId, role.id);
    }
  }

  console.log('✓ Test users seeded');
  console.log('  📧 邮箱格式账号（前端快速登录）:');
  console.log('    - admin@huashan-hospital.com / demo123456 (华山医院)');
  console.log('    - admin@rjh.com.cn / demo123456 (瑞金医院)');
  console.log('    - research@meddata-inst.edu.cn / demo123456 (研究院)');
  console.log('    - contact@smartmed-ai.com / demo123456 (智慧医疗AI)');
  console.log('    - data-governance@health.gov.cn / demo123456 (卫健委)');
  console.log('  👤 用户名格式账号:');
  console.log('    - admin / admin123 (系统管理员)');
  console.log('    - hospital1 / hospital123 (华山医院)');
  console.log('    - hospital2 / hospital123 (瑞金医院)');
  console.log('    - researcher1 / researcher123 (研究员)');
  console.log('    - regulator1 / regulator123 (监管员)');
}

// JWT 认证中间件
function authenticateToken(req, res, next) {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];

  if (!token) {
    return res.status(401).json({ error: '未提供认证令牌' });
  }

  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) {
      return res.status(403).json({ error: '令牌无效或已过期' });
    }
    req.user = user;
    next();
  });
}

// 权限检查中间件
function requirePermissions(...permissions) {
  return (req, res, next) => {
    const user = req.user;
    if (!user) {
      return res.status(401).json({ error: '未登录' });
    }

    // 管理员拥有所有权限
    if (user.permissions.includes('*')) {
      return next();
    }

    // 检查是否拥有所需权限
    const hasPermission = permissions.some(perm => user.permissions.includes(perm));
    if (!hasPermission) {
      return res.status(403).json({ error: '权限不足' });
    }

    next();
  };
}

// 获取用户完整信息（包含角色和权限）
function getUserWithPermissions(userId) {
  const user = db.prepare(`
    SELECT id, username, real_name, tenant_id, department_id, data_scope, status
    FROM users WHERE id = ? AND is_deleted = 0
  `).get(userId);

  if (!user) return null;

  // 获取用户角色
  const roles = db.prepare(`
    SELECT r.id, r.code, r.name, r.data_scope
    FROM roles r
    JOIN user_roles ur ON r.id = ur.role_id
    WHERE ur.user_id = ?
  `).all(userId);

  // 获取用户权限
  const permissions = db.prepare(`
    SELECT DISTINCT p.code
    FROM permissions p
    JOIN role_permissions rp ON p.id = rp.permission_id
    JOIN user_roles ur ON rp.role_id = ur.role_id
    WHERE ur.user_id = ?
  `).all(userId);

  return {
    id: user.id,
    username: user.username,
    realName: user.real_name,
    tenantId: user.tenant_id,
    departmentId: user.department_id,
    dataScope: user.data_scope,
    status: user.status,
    roles: roles,
    permissions: permissions.map(p => p.code),
  };
}

// 初始化数据库
initDatabase();
seedPermissions();
seedRoles();
seedUsers().catch(console.error);

// ============ 认证 API ============

// 登录
app.post('/api/auth/login', async (req, res) => {
  const { username, password } = req.body;

  if (!username || !password) {
    return res.status(400).json({ error: '用户名和密码不能为空' });
  }

  try {
    // 查找用户
    const user = db.prepare(`
      SELECT id, username, password_hash, real_name, tenant_id, data_scope, status
      FROM users WHERE username = ? AND is_deleted = 0
    `).get(username);

    if (!user) {
      return res.status(401).json({ error: '用户名或密码错误' });
    }

    if (user.status !== 'active') {
      return res.status(403).json({ error: '账号已被禁用' });
    }

    // 验证密码
    const isPasswordValid = await bcrypt.compare(password, user.password_hash);
    if (!isPasswordValid) {
      return res.status(401).json({ error: '用户名或密码错误' });
    }

    // 更新最后登录时间
    db.prepare('UPDATE users SET last_login_at = CURRENT_TIMESTAMP WHERE id = ?').run(user.id);

    // 获取用户完整信息
    const userWithPermissions = getUserWithPermissions(user.id);

    // 生成 JWT token
    const token = jwt.sign(
      {
        id: user.id,
        username: user.username,
        tenantId: user.tenant_id,
        permissions: userWithPermissions.permissions,
      },
      JWT_SECRET,
      { expiresIn: JWT_EXPIRES_IN }
    );

    res.json({
      access_token: token,
      user: userWithPermissions,
    });
  } catch (error) {
    console.error('Login error:', error);
    res.status(500).json({ error: '登录失败' });
  }
});

// 获取当前用户信息
app.get('/api/auth/profile', authenticateToken, (req, res) => {
  const user = getUserWithPermissions(req.user.id);
  if (!user) {
    return res.status(404).json({ error: '用户不存在' });
  }
  res.json(user);
});

// 登出（客户端删除 token 即可）
app.post('/api/auth/logout', authenticateToken, (req, res) => {
  res.json({ message: '已退出登录' });
});

// ============ 用户管理 API ============

// 获取用户列表
app.get('/api/users', authenticateToken, requirePermissions('user:read'), (req, res) => {
  const users = db.prepare(`
    SELECT id, username, real_name, tenant_id, department_id, data_scope, status, created_at
    FROM users WHERE is_deleted = 0
  `).all();

  // 为每个用户获取角色
  const usersWithRoles = users.map(user => {
    const roles = db.prepare(`
      SELECT r.id, r.code, r.name
      FROM roles r
      JOIN user_roles ur ON r.id = ur.role_id
      WHERE ur.user_id = ?
    `).all(user.id);

    return {
      ...user,
      roles: roles
    };
  });

  res.json({ data: usersWithRoles });
});

// 获取用户详情
app.get('/api/users/:id', authenticateToken, requirePermissions('user:read'), (req, res) => {
  const user = getUserWithPermissions(req.params.id);
  if (!user) {
    return res.status(404).json({ error: '用户不存在' });
  }
  res.json({ data: user });
});

// 创建用户
app.post('/api/users', authenticateToken, requirePermissions('user:create'), async (req, res) => {
  const { username, password, realName, tenantId, departmentId, dataScope, roleIds } = req.body;

  if (!username || !password || !realName || !tenantId) {
    return res.status(400).json({ error: '缺少必填字段' });
  }

  try {
    // 检查用户名是否已存在
    const existing = db.prepare('SELECT id FROM users WHERE username = ?').get(username);
    if (existing) {
      return res.status(400).json({ error: '用户名已存在' });
    }

    // 哈希密码
    const passwordHash = await bcrypt.hash(password, 10);
    const userId = uuidv4();

    // 插入用户
    db.prepare(`
      INSERT INTO users (id, username, password_hash, real_name, tenant_id, department_id, data_scope)
      VALUES (?, ?, ?, ?, ?, ?, ?)
    `).run(userId, username, passwordHash, realName, tenantId, departmentId || null, dataScope || 'self');

    // 分配角色
    if (roleIds && Array.isArray(roleIds)) {
      const insertUserRole = db.prepare('INSERT INTO user_roles (id, user_id, role_id) VALUES (?, ?, ?)');
      for (const roleId of roleIds) {
        insertUserRole.run(uuidv4(), userId, roleId);
      }
    }

    const newUser = getUserWithPermissions(userId);
    res.json({ data: newUser });
  } catch (error) {
    console.error('Create user error:', error);
    res.status(500).json({ error: '创建用户失败' });
  }
});

// 更新用户
app.put('/api/users/:id', authenticateToken, requirePermissions('user:update'), async (req, res) => {
  const { realName, tenantId, departmentId, dataScope, status, password } = req.body;
  const userId = req.params.id;

  try {
    const user = db.prepare('SELECT id FROM users WHERE id = ? AND is_deleted = 0').get(userId);
    if (!user) {
      return res.status(404).json({ error: '用户不存在' });
    }

    // 构建更新语句
    const updates = [];
    const values = [];

    if (realName) {
      updates.push('real_name = ?');
      values.push(realName);
    }
    if (tenantId) {
      updates.push('tenant_id = ?');
      values.push(tenantId);
    }
    if (departmentId !== undefined) {
      updates.push('department_id = ?');
      values.push(departmentId);
    }
    if (dataScope) {
      updates.push('data_scope = ?');
      values.push(dataScope);
    }
    if (status) {
      updates.push('status = ?');
      values.push(status);
    }
    if (password) {
      const passwordHash = await bcrypt.hash(password, 10);
      updates.push('password_hash = ?');
      values.push(passwordHash);
    }

    if (updates.length > 0) {
      updates.push('updated_at = CURRENT_TIMESTAMP');
      values.push(userId);
      db.prepare(`UPDATE users SET ${updates.join(', ')} WHERE id = ?`).run(...values);
    }

    const updatedUser = getUserWithPermissions(userId);
    res.json({ data: updatedUser });
  } catch (error) {
    console.error('Update user error:', error);
    res.status(500).json({ error: '更新用户失败' });
  }
});

// 删除用户（软删除）
app.delete('/api/users/:id', authenticateToken, requirePermissions('user:delete'), (req, res) => {
  const userId = req.params.id;

  const user = db.prepare('SELECT id FROM users WHERE id = ? AND is_deleted = 0').get(userId);
  if (!user) {
    return res.status(404).json({ error: '用户不存在' });
  }

  db.prepare('UPDATE users SET is_deleted = 1, updated_at = CURRENT_TIMESTAMP WHERE id = ?').run(userId);
  res.json({ message: '用户已删除' });
});

// 分配角色
app.put('/api/users/:id/roles', authenticateToken, requirePermissions('user:update'), (req, res) => {
  const userId = req.params.id;
  const { roleIds } = req.body;

  if (!Array.isArray(roleIds)) {
    return res.status(400).json({ error: 'roleIds 必须是数组' });
  }

  try {
    const user = db.prepare('SELECT id FROM users WHERE id = ? AND is_deleted = 0').get(userId);
    if (!user) {
      return res.status(404).json({ error: '用户不存在' });
    }

    // 删除现有角色
    db.prepare('DELETE FROM user_roles WHERE user_id = ?').run(userId);

    // 添加新角色
    const insertUserRole = db.prepare('INSERT INTO user_roles (id, user_id, role_id) VALUES (?, ?, ?)');
    for (const roleId of roleIds) {
      insertUserRole.run(uuidv4(), userId, roleId);
    }

    const updatedUser = getUserWithPermissions(userId);
    res.json({ data: updatedUser });
  } catch (error) {
    console.error('Assign roles error:', error);
    res.status(500).json({ error: '分配角色失败' });
  }
});

// ============ 角色管理 API ============

// 获取角色列表
app.get('/api/roles', authenticateToken, requirePermissions('user:read'), (req, res) => {
  const roles = db.prepare('SELECT * FROM roles ORDER BY is_system DESC, created_at DESC').all();

  // 为每个角色获取权限
  const rolesWithPermissions = roles.map(role => {
    const permissions = db.prepare(`
      SELECT p.id, p.code, p.name, p.resource, p.action
      FROM permissions p
      JOIN role_permissions rp ON p.id = rp.permission_id
      WHERE rp.role_id = ?
    `).all(role.id);

    return {
      ...role,
      permissions: permissions
    };
  });

  res.json({ data: rolesWithPermissions });
});

// 获取角色详情
app.get('/api/roles/:id', authenticateToken, requirePermissions('user:read'), (req, res) => {
  const role = db.prepare('SELECT * FROM roles WHERE id = ?').get(req.params.id);
  if (!role) {
    return res.status(404).json({ error: '角色不存在' });
  }

  const permissions = db.prepare(`
    SELECT p.id, p.code, p.name, p.resource, p.action
    FROM permissions p
    JOIN role_permissions rp ON p.id = rp.permission_id
    WHERE rp.role_id = ?
  `).all(role.id);

  res.json({ data: { ...role, permissions } });
});

// 创建角色
app.post('/api/roles', authenticateToken, requirePermissions('user:create'), (req, res) => {
  const { code, name, description, tenantId, dataScope, permissionIds } = req.body;

  if (!code || !name) {
    return res.status(400).json({ error: '缺少必填字段' });
  }

  try {
    const existing = db.prepare('SELECT id FROM roles WHERE code = ?').get(code);
    if (existing) {
      return res.status(400).json({ error: '角色代码已存在' });
    }

    const roleId = uuidv4();
    db.prepare(`
      INSERT INTO roles (id, code, name, description, tenant_id, data_scope, is_system)
      VALUES (?, ?, ?, ?, ?, ?, 0)
    `).run(roleId, code, name, description || null, tenantId || null, dataScope || 'self');

    // 分配权限
    if (permissionIds && Array.isArray(permissionIds)) {
      const insertRolePermission = db.prepare('INSERT INTO role_permissions (id, role_id, permission_id) VALUES (?, ?, ?)');
      for (const permId of permissionIds) {
        insertRolePermission.run(uuidv4(), roleId, permId);
      }
    }

    const newRole = db.prepare('SELECT * FROM roles WHERE id = ?').get(roleId);
    res.json({ data: newRole });
  } catch (error) {
    console.error('Create role error:', error);
    res.status(500).json({ error: '创建角色失败' });
  }
});

// 分配权限给角色
app.put('/api/roles/:id/permissions', authenticateToken, requirePermissions('user:update'), (req, res) => {
  const roleId = req.params.id;
  const { permissionIds } = req.body;

  if (!Array.isArray(permissionIds)) {
    return res.status(400).json({ error: 'permissionIds 必须是数组' });
  }

  try {
    const role = db.prepare('SELECT id, is_system FROM roles WHERE id = ?').get(roleId);
    if (!role) {
      return res.status(404).json({ error: '角色不存在' });
    }

    if (role.is_system) {
      return res.status(403).json({ error: '系统角色不可修改' });
    }

    // 删除现有权限
    db.prepare('DELETE FROM role_permissions WHERE role_id = ?').run(roleId);

    // 添加新权限
    const insertRolePermission = db.prepare('INSERT INTO role_permissions (id, role_id, permission_id) VALUES (?, ?, ?)');
    for (const permId of permissionIds) {
      insertRolePermission.run(uuidv4(), roleId, permId);
    }

    const permissions = db.prepare(`
      SELECT p.id, p.code, p.name
      FROM permissions p
      JOIN role_permissions rp ON p.id = rp.permission_id
      WHERE rp.role_id = ?
    `).all(roleId);

    res.json({ data: { roleId, permissions } });
  } catch (error) {
    console.error('Assign permissions error:', error);
    res.status(500).json({ error: '分配权限失败' });
  }
});

// ============ 权限管理 API ============

