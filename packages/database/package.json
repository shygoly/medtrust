{
  "name": "@medtrust/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "migration:generate": "typeorm migration:generate",
    "migration:run": "typeorm migration:run",
    "migration:revert": "typeorm migration:revert",
    "seed": "tsc && node dist/capability/seed-capability.cli.js",
    "seed:check": "tsc && node dist/capability/seed-capability.cli.js --check"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.3.0"
  },
  "license": "LicenseRef-MedTrust-Research-1.0"
}
