{
  "name": "@medtrust/mdop",
  "version": "0.1.0",
  "description": "MDOP 协议核心（领域中立）——信封、流动标签、计划/凭证/句柄/回执 schema、JCS+SM3、国标 SM2、凭证校验。平台编译器与连接器复核共用同一份实现（D-MDOP-1）。",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node scripts/check-domain-neutral.mjs && jest",
    "test:interop": "tsc && node scripts/interop-sm2.mjs",
    "test:domain-neutral": "node scripts/check-domain-neutral.mjs"
  },
  "dependencies": {
    "sm-crypto": "^0.3.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "license": "LicenseRef-MedTrust-Research-1.0"
}
