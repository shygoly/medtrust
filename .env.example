# Application
NODE_ENV=development
PORT=5021

# Database (paths are relative to apps/api when running pnpm --filter api dev)
# 样例只放键位与占位（MS-34）：缺省值见 DEPLOY.md §2 / 代码 fallback（./data/*.db）
DATABASE_URL=
CONTROL_PLANE_DB_URL=

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
AUTH_CAPTCHA_REQUIRED=false
SEED_DEMO_USERS=true
SWAGGER_ENABLED=true

# Mail (P0-6 忘记密码;生产必填,否则 fail-closed)
SMTP_URL=

# SMS (P1-2 手机快捷登录;生产必填,否则 fail-closed)
SMS_GATEWAY_URL=

# Silk Road interop (P2-2 丝路数港互认;生产必填 endpoint,否则 fail-closed)
SILKROAD_NODE_ENDPOINT=
SILKROAD_NODE_ID=silk-road

# Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Key Cache Configuration
KEY_CACHE_TTL_SECONDS=300

# Audit Logging
AUDIT_LOG_UNMASKED_ACCESS=true

# External Services - Privacy Computing
FATE_FLOW_URL=https://medtrust-fate-flow.fly.dev
FATE_FLOW_TIMEOUT=300000

# External Services - Multi-Party Computation
MP_SPDZ_GATEWAY_URL=https://medtrust-mp-spdz-gateway.fly.dev
MP_SPDZ_TIMEOUT=60000

# External Services - Blockchain (ChainMaker via HTTP sidecar)
CHAIN_SIDECAR_URL=https://medtrust-chain.fly.dev

# External Services - Alibaba Cloud SGX
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
ALIBABA_CLOUD_REGION=cn-hongkong
ALIBABA_CLOUD_SGX_INSTANCE_TYPE=ecs.g7t.large
ALIBABA_CLOUD_SGX_IMAGE_ID=your-sgx-image-id

# External Services - FHIR
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# Xian node open-api (国家数据流通利用基础设施·西安节点 三方应用集成)
XIAN_APP_KEY=
XIAN_SM2_PRIVATE_KEY_PKCS8_B64=
XIAN_WEB_BASE_URL=http://localhost:5020
XIAN_TIMESTAMP_TZ_OFFSET=+08:00
XIAN_TIMESTAMP_WINDOW_MS=300000
XIAN_LOGIN_TICKET_TTL_MS=60000
XIAN_TENANT_ROLE_MAP={"40044":"provider"}

# Frontend
FRONTEND_URL=http://localhost:5020
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=true

# Feature Flags
FEATURE_FEDERATED_LEARNING=true
FEATURE_MPC=true
FEATURE_TEE=true
FEATURE_BLOCKCHAIN=true
FEATURE_FHIR=true

# Connector auth / heartbeat (P1-4 / P1-9)
# 缺省强制证书认证；本地开发若要走令牌降级,须同时打开下面的开关并显式配置令牌值
CONNECTOR_TOKEN_AUTH_ALLOWED=false
CONNECTOR_CERT_FINGERPRINT=
CONNECTOR_SM2_PRIVATE_KEY=
CONNECTOR_SM2_PRIVATE_KEY_FILE=
CONNECTOR_PLATFORM_CA_PUBKEY=
CONNECTOR_PLATFORM_NODE_PUBKEY=
CONNECTOR_REGISTRY_PUBKEY=

# 平台三把私钥的加密密钥（SM4 KEK；生产缺此键平台拒绝启动，D-MDOP-3）
PLATFORM_KEK=

# 离线核验器接受旧格式签名的截止时间（缺省 2026-09-24T00:00:00Z，见 scripts/verify-endorsement.mjs）
SM2_LEGACY_CUTOFF=

# MDOP 内核总开关（缺省 false；连接器侧开启才会处理 MDOP 信封）
MDOP_ENABLED=false
# 会话见证验签用的 KMS 公钥（缺省空＝拒绝登记见证，fail-closed；MUST 来自部署配置）
MDOP_KMS_PUBKEY=
# 可信校验方白名单（逗号分隔；缺省空＝拒绝登记）
MDOP_ATTESTATION_VERIFIERS=
# 注册中心认可的度量白名单（sm3:<64hex>，逗号分隔）
MDOP_ATTESTATION_MEASUREMENTS=
CONNECTOR_VERSION=1.0.0
CONNECTOR_OFFLINE_MS=60000

# Long-poll task delivery (outbound-longpoll-agent-auth)
CONNECTOR_LONG_POLL_WAIT_MS=25000

# Connector ML sidecar (apps/connector-ml, port 5030)
CONNECTOR_ML_URL=http://localhost:5030

# L3 causal agent (apps/agent gRPC). Unset → connector fail-closed (no Echo).
AGENT_GRPC_URL=127.0.0.1:5024
