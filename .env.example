# Application
NODE_ENV=development
PORT=5021

# Database
DATABASE_URL=./data/medtrust.db

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token-12345

# Key Cache Configuration
KEY_CACHE_TTL_SECONDS=300

# Audit Logging
AUDIT_LOG_UNMASKED_ACCESS=true

# External Services - Privacy Computing
FATE_FLOW_URL=https://medtrust-fate-flow.fly.dev
FATE_FLOW_TIMEOUT=300000

# External Services - Multi-Party Computation
MP_SPDZ_GATEWAY_URL=https://medtrust-mp-spdz-gateway.fly.dev
MP_SPDZ_TIMEOUT=60000
MP_SPDZ_PROTOCOL=shamir

# External Services - Blockchain (FISCO BCOS)
FISCO_BCOS_NODE1_URL=https://medtrust-fisco-node1.fly.dev
FISCO_BCOS_NODE2_URL=https://medtrust-fisco-node2.fly.dev
FISCO_BCOS_NODE3_URL=https://medtrust-fisco-node3.fly.dev
FISCO_BCOS_DEV_NODE_URL=http://localhost:8545
FISCO_BCOS_CHAIN_ID=1
FISCO_BCOS_GROUP_ID=1
FISCO_BCOS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VAULT_ATTESTATION_KEY_PATH=secret/data/blockchain/attestation-key

# External Services - Alibaba Cloud SGX
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
ALIBABA_CLOUD_REGION=cn-hongkong
ALIBABA_CLOUD_SGX_INSTANCE_TYPE=ecs.g7t.large
ALIBABA_CLOUD_SGX_IMAGE_ID=your-sgx-image-id

# External Services - FHIR
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4
FHIR_TIMEOUT=30000

# Feature Flags
FEATURE_FEDERATED_LEARNING=true
FEATURE_MPC=true
FEATURE_TEE=true
FEATURE_BLOCKCHAIN=true
FEATURE_FHIR=true
