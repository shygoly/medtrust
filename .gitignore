# 生成的 RWS 测试数据(可从 seed 复现,D-DATA-1)
data/rws-test-data/
# 一键重跑产物(L4-repro:可复现性验收报告;reproduce:l4 重新生成)
data/repro/

# AMR sentinel 原始采集数据(大文件,可用 scripts/amr/*.py 按采集手册重抓;字典 data/dict/ 保留版本控制)
data/raw/
data/synthetic/

# Video projects (large render assets — not pushed)
/video/
/medtrust-video/

# Python bytecode
__pycache__/
*.pyc
*.egg-info/

# TokenCrusher (machine-local graph data)
.tokencrusher/

# Conductor workflow outputs (regeneratable)
.conductor/out/

# OpenCode project config (contains API keys)
opencode.json

# Maven build artifacts (chain-sdk sidecar) — built remotely on fly deploy
fly-services/chain-sdk/target/

# Synthea data (generated — output 687MB, jar 192MB, ingested 17MB)
data/synthea/output/
data/synthea/synthea-with-dependencies.jar
data/synthea/ingested/
# Keep-Module diabetes cohort FHIR/CSV (~300MB+) — regenerate via scripts/generate-synthea-diabetes.sh
data/synthea/diabetes-cohort/fhir/
data/synthea/diabetes-cohort/csv/
data/synthea/diabetes-cohort/metadata/
# RWS 三场景共用的 7000 人合成人群基座（CSV 约 5.7GB）。只入库 metadata/（记着 seed、人数、
# 年龄段、时间窗，可据此重新生成）；data/demo/{ve,dedup,external-control} 由它派生并已入库。
data/synthea/rws-showcase/csv/

# tokencrusher runtime artifacts
.token-pilot/
.token-pilot-fingerprint.json

# Demo screenshots (environment-specific)
docs/demo/screenshots/
docs/demo/*.png
compliance-overview.png
prod-compliance-overview.png

# 顶层 Synthea / 生成数据集输出(与 data/synthea/output/ 同类;TD-7 的同类物防复发)
/output/

# agent 运行态与本地工具状态(非仓库内容)
# ⚠ .agent-runs/ **不得**加进这里: AGENT-OPS §4 明文「血缘目录入库(不 gitignore)」。
# 2026-09-26 修正: 此前本文件误将 .agent-runs/ 列入忽略, 会使**新**会话的血缘记录
# 被静默排除(已跟踪的 37 条不受影响, 故不易察觉)——属"元语说的与代码做的不一致",
# 按 AGENT-OPS AO-2 以元语为准, 删除该条。
.dsh-verify/
.workbuddy/
.tmp-wb.py
/screenshots/

# Added by Spec Kitty CLI (auto-managed)
# 偏离说明(2026-09-26 解 UU 冲突时):原块整体忽略 .claude/,但本仓把
# .claude/{commands,hooks,skills,settings.json} 当仓库内容用(opsx 命令、
# on-* 钩子、项目 skill medtrust-data-pricing)。故改为「忽略 .claude 下运行态、
# 保留内容目录」,避免新 skill/命令被静默漏加(需 git add -f 才能发现)。
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
.codex/
.vibe/
.opencode/
.windsurf/
.gemini/
.cursor/
.qwen/
.kilocode/
.augment/
.roo/
.amazonq/
.kiro/
.agent/
.github/copilot/
.kittify/.dashboard
.kittify/charter/context-state.json
.kittify/charter/directives.yaml
.kittify/charter/governance.yaml
.kittify/charter/metadata.yaml
.kittify/charter/references.yaml
.kittify/dossiers/
.kittify/events/
.kittify/merge-state.json
.kittify/missions/__pycache__/
.kittify/runtime/
.kittify/workspaces/

# ---- 商业材料 / 演示物料 / 大体积二进制(2026-09-26 定案: 不入库) ----
# 背景: 这批文件此前一直未跟踪, 是 git status 的长期噪声来源, 且含营业执照扫描件
# 与 62.8MB 二进制。经人工同意按"排除"处理。
# 注意: gitignore 不影响已跟踪文件; 下列路径此前均未被跟踪。

# 演示/商业二进制(根目录与 pitch/)
/*.pptx
/*.docx
/*.pdf
/*.jpg
/pitch/*.pptx
/pitch/*.pdf

# 环境相关截图(根目录; 与既有 docs/demo/*.png 同类)
/kimi-bridge-*.png
/l0-*.png
/rws-form-*.png
/rws-detail-*.png
/fig1-login.png

# 竞赛附件(第三方二进制, 非本仓产物)
/research/competitions/**/attachments/

# 大体积二进制参考数据(literature.parquet 约 62.8MB)
data/normalized/*.parquet

# ---- 以下刻意*不*忽略, 归属仍待人工决定(见 docs/CURSOR_TASKS_C2_HARDENING.md 讨论) ----
# pitch/generators/**      → JS 源码 + README, 更像仓库内容而非物料
# research/competitions/**/*.md → 竞赛笔记
# .keel/**                 → keel 工具状态(as-is.yaml / extraction-run.json);
#                            keel 的 model.yaml 按方法论通常应入库, 故不擅自忽略

# ---- 第三方/交付物二进制(2026-09-27 定案: 不入库) ----
# 注意: docs/*.pdf 下有 7 份**已被跟踪**的 PDF(入驻指引/部署准备/配合测试清单/方案等),
# 故此处**不**加宽泛的 docs/*.pdf 规则, 只忽略点名的第三方材料, 避免误伤在库文档。
*.zip
/docs/面向共享交互的能源大数据安全防护关键技术研究-技术报告-国网河南省电力公司经济技术研究院.pdf

