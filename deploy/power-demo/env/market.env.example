# Copy to env/market.env and fill in. env/*.env is gitignored.
NODE_ENV=development
DB_SYNCHRONIZE=true
SPACE_ID=hn-power
CONNECTOR_PARTICIPANT_ID=p-market-hn
CONNECTOR_PORT=5022
CONTROL_PLANE_URL=http://api:5021/api/v1
CONNECTOR_DB_URL=postgres://<user>:<password>@db:5432/medtrust_connector_power_market?sslmode=disable
CONNECTOR_DATA_ROOT=/power-data
CONNECTOR_CATALOG_WARMUP=dp-pwr-demo-load-market
CONNECTOR_POLL_INTERVAL_MS=3000
CONNECTOR_LONG_POLL_WAIT_MS=20000
CONNECTOR_SM2_PRIVATE_KEY_FILE=/keys/power-market.key
CONNECTOR_CERT_FINGERPRINT=SM2:<fingerprint>
CONNECTOR_PLATFORM_CA_PUBKEY=<platform-ca-public-key>
CONNECTOR_PLATFORM_NODE_PUBKEY=<platform-node-public-key>
CONNECTOR_REGISTRY_PUBKEY=<registry-public-key>
CONNECTOR_LOCAL_ADMIN_TOKEN=<local-admin-token>
CONNECTOR_MDOP_CONTRACT_POLICY_FILE=/policy.json
CONNECTOR_MDOP_WATERMARK=wm:power:market
CONNECTOR_POWER_PSEUDONYM_KEY=<at-least-32-char-shared-key>
CONNECTOR_PULL_TOKEN=<pull-token>
MDOP_ENABLED=true
